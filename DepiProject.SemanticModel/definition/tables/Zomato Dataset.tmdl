	column Cleaned_Time_Order_picked
		dataType: dateTime
		formatString: Long Time
		lineageTag: c8132587-7a83-45b8-bcc3-156fff5ec768
		summarizeBy: none
		sourceColumn: Cleaned_Time_Order_picked

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Time

	column page3_Order_Prep_Time_min = ```
			
			VAR StartTime = 'Zomato Dataset'[Cleaned_Time_Orderd]
			VAR EndTime = 'Zomato Dataset'[Cleaned_Time_Order_picked]
			VAR RawMinutes = DATEDIFF(StartTime, EndTime, MINUTE)
			RETURN 
			    IF(
			        RawMinutes < 0, 
			        RawMinutes + 1440, 
			        RawMinutes
			    )
			```
		formatString: 0
		lineageTag: 90230fab-25f1-471d-8662-de5a3325a5ed
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column page3_Transit_Time_min = 'Zomato Dataset'[Time_taken (min)] - 'Zomato Dataset'[page3_Order_Prep_Time_min]
		lineageTag: 5b6deef5-ae82-40ac-947e-97a6bc42a725
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column page3_Distance_km = ```
			
			VAR Lat1 = RADIANS('Zomato Dataset'[Restaurant_latitude])
			VAR Lon1 = RADIANS('Zomato Dataset'[Restaurant_longitude])
			VAR Lat2 = RADIANS('Zomato Dataset'[Delivery_location_latitude])
			VAR Lon2 = RADIANS('Zomato Dataset'[Delivery_location_longitude])
			
			VAR dLat = Lat2 - Lat1
			VAR dLon = Lon2 - Lon1
			
			VAR a = SIN(dLat / 2)^2 + COS(Lat1) * COS(Lat2) * SIN(dLon / 2)^2
			VAR c = 2 * ASIN(SQRT(a))
			VAR R = 6371 
			
			RETURN R * c
			```
		formatString: 0.00
		lineageTag: 6adc823f-7ea9-47ae-a612-eee9fe1fa925
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column page3_Speed_kmph =
			
			IF(
			    'Zomato Dataset'[Time_taken (min)] > 0,
			    'Zomato Dataset'[Distance_km] / ('Zomato Dataset'[Time_taken (min)] / 60),
			    BLANK()
			)
		formatString: 0.00
		lineageTag: 6cb6fb55-5321-48fe-bc19-bc4cd04c0357
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column page3_Bottleneck_Flag =
			
			VAR MedianPrep = MEDIAN('Zomato Dataset'[page3_Order_Prep_Time_min])
			VAR MedianTransit = MEDIAN('Zomato Dataset'[page3_Transit_Time_min])
			VAR CurrentPrep = 'Zomato Dataset'[page3_Order_Prep_Time_min]
			VAR CurrentTransit = 'Zomato Dataset'[page3_Transit_Time_min]
			RETURN
			    SWITCH(
			        TRUE(),
			        CurrentPrep > MedianPrep && CurrentTransit > MedianTransit, "Both delayed",
			        CurrentPrep > MedianPrep, "Kitchen delay",
			        CurrentTransit > MedianTransit, "Road delay",
			        "Normal"
			    )
		lineageTag: 544f04cf-d37f-4f27-8a64-0011b44695fc
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

