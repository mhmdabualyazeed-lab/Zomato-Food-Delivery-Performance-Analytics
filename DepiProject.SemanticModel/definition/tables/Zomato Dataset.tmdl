	column Delivery_Latitude_Clean =
			
			IF(
			    'Zomato Dataset'[Delivery_location_latitude] < 1 && 'Zomato Dataset'[Delivery_location_latitude] > -1,
			    BLANK(),
			    'Zomato Dataset'[Delivery_location_latitude]
			)
		formatString: 0.0000000
		lineageTag: d2a02243-c582-4d2f-94a9-46c365bb0232
		dataCategory: Latitude
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Delivery_Long_Clean =
			
			IF(
			    'Zomato Dataset'[Delivery_location_longitude] < 1 && 'Zomato Dataset'[Delivery_location_longitude] > -1,
			    BLANK(),
			    'Zomato Dataset'[Delivery_location_longitude]
			)
		lineageTag: 4d8baf20-268d-4bd2-a65d-b1963b439aac
		dataCategory: Longitude
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column Distance_km =
			
			VAR lat1 = RADIANS('Zomato Dataset'[Restaurant_Lat_Clean])
			VAR lon1 = RADIANS('Zomato Dataset'[Restaurant_Long_Clean])
			VAR lat2 = RADIANS('Zomato Dataset'[Delivery_location_latitude])
			VAR lon2 = RADIANS('Zomato Dataset'[Delivery_location_longitude])
			VAR dlat = lat2 - lat1
			VAR dlon = lon2 - lon1
			VAR a = SIN(dlat/2)^2 + COS(lat1) * COS(lat2) * SIN(dlon/2)^2
			VAR c = 2 * ASIN(SQRT(a))
			VAR R = 6371 -- Earth's radius in km
			RETURN R * c
		formatString: 0.00
		lineageTag: 4e4fd2d4-6f36-424e-a287-5b9c90a604bb
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Restaurant_Long_Clean =
			
